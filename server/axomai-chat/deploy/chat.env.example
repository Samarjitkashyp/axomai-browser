# Copy to /etc/axomai-browser/chat.env on the server (owner root, group axomai-browser, mode 640).
# The key is typed on the server by the owner. Never put it in git or send it in a chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Daily limits (UTC day)
LIMIT_PER_CLIENT=30
LIMIT_PER_IP=60
LIMIT_GLOBAL=500
LIMIT_BURST_PER_MINUTE=6
MAX_OUTPUT_TOKENS=900
